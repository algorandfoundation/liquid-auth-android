<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <!-- Declare any variables if needed -->
    </data>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/mnemonicInputField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter or generate your mnemonic"
            android:padding="8dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/generateNewMnemonicButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate New Mnemonic"
            android:padding="8dp"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/storeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Store Mnemonic"
            android:padding="8dp"
            android:layout_marginTop="16dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </LinearLayout>
</layout>